[Unit]
Description=DoomsdayOS boot failure observation (non-destructive)
After=local-fs.target
RequiresMountsFor=/var/lib/doomsday-vault
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/doomsday-firstboot/app/recovery_watch.py boot-start
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/doomsday-vault
TimeoutStartSec=20s
