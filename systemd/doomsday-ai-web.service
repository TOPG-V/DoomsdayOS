[Unit]
Description=DoomsdayOS local offline AI workspace
After=network.target doomsday-kiwix.service
[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/doomsday-firstboot/app/ai_gateway.py --port 8765
Restart=on-failure
RestartSec=8
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=768M
ReadWritePaths=/var/lib/doomsday-vault
# Root-owned local gateway needs queue metadata writes for validated ZIM enqueues.
# ZFS archive mounts remain outside the service's writable allowlist.
[Install]
WantedBy=multi-user.target
